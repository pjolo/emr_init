// ============================================================
// 1) Measles virus IgG Ab [Titer] in Serum
//    Einheit: Titer – wird als Ratio oder als {titer} dargestellt
// ============================================================
Instance: Observation-Measles-IgG-Titer
InstanceOf: http://fhir.ch/ig/ch-vacd/StructureDefinition/ch-vacd-laboratory-serology
Title: "Measles virus IgG Ab [Titer] in Serum"
Description: "Beispiel für einen Titer-Wert (1:64). Titer werden in UCUM als {titer} codiert, der numerische Wert repräsentiert den Nenner (z.B. 64 für 1:64)."
Usage: #example

* meta.profile = "http://fhir.ch/ig/ch-vacd/StructureDefinition/ch-vacd-laboratory-serology"

* extension[0].url = "http://fhir.ch/ig/ch-core/StructureDefinition/ch-ext-author"
* extension[=].valueReference = Reference(PractitionerRole/6-1-PractitionerRole)

* extension[+].url = "http://fhir.ch/ig/ch-vacd/StructureDefinition/ch-vacd-ext-verification-status"
* extension[=].valueCoding = http://snomed.info/sct#59156000 "Confirmed"

* identifier.system = "urn:ietf:rfc:3986"
* identifier.value = "urn:uuid:aaa11111-1111-1111-1111-111111111111"

* status = #final

* code.coding[0].system = "http://loinc.org"
* code.coding[0].code = #22502-9
* code.coding[0].display = "Measles virus IgG Ab [Titer] in Serum"

* subject = Reference(Patient/3-1-Patient)
* effectiveDateTime = "2024-06-15"
* performer = Reference(PractitionerRole/6-1-PractitionerRole)

// TITER: Der Wert 64 repräsentiert einen Titer von 1:64
// UCUM-Code {titer} ist ein "arbitrary unit" für Titer-Angaben
* valueQuantity.value = 64
* valueQuantity.unit = "{titer}"
* valueQuantity.system = "http://unitsofmeasure.org"
* valueQuantity.code = #{titer}
* valueQuantity.comparator = #>= // optional: >= 1:64

* interpretation.coding[0].system = "http://terminology.hl7.org/CodeSystem/v3-ObservationInterpretation"
* interpretation.coding[0].code = #POS
* interpretation.coding[0].display = "Positive"


